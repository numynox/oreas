# Airtable Personal Access Token – scopes: data.records:read, schema.bases:read, data.records:write (ratings), schema.bases:write (creating tables/columns)
# Used server-side only (Vite dev proxy / nginx proxy). Never committed, never sent to the browser.
AIRTABLE_API_KEY=
AIRTABLE_BASE_ID=
# Host port for docker compose
OREAS_PORT=8080
